# ============================================
# PLUGINS
# Nur das Projekt-Plugin wird versioniert.
# media-lab-* liegen zentral im Starter Kit,
# Drittanbieter-Plugins kommen per ZIP/Composer.
# ============================================
/cms/wp-content/plugins/*
!/cms/wp-content/plugins/index.php
!/cms/wp-content/plugins/churum-meru-plugin/

# ============================================
# MU-PLUGINS
# Eigene mu-plugins sind versioniert,
# nur lokale Fixes bleiben draußen.
# ============================================
/cms/wp-content/mu-plugins/cf7-autoload-fix.php
/cms/wp-content/mu-plugins/temp-revision-fix.php

# ============================================
# THEMES
# ============================================
/cms/wp-content/themes/twenty*/

# Build-Output und Vite-Hot-File (themeunabhängig)
/cms/wp-content/themes/*/assets/dist/
/cms/wp-content/themes/*/assets/hot

